# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
*.egg
build/
dist/
.eggs/
*.so
pip-wheel-metadata/

# --- Virtual environments ---
venv/
.venv/
env/
ENV/
.python-version

# --- Test / tooling caches ---
.pytest_cache/
.ruff_cache/
.mypy_cache/
.tox/
.nox/
.coverage
.coverage.*
coverage.xml
htmlcov/
.ipynb_checkpoints/

# --- Secrets / local environment ---
# credentials.py reads API keys from the environment; never commit a real .env.
.env
.env.*
!.env.example
*.pem
*.key

# --- PHRAK per-workspace state (config + index + skills + reports + PoCs) ---
# Everything PHRAK generates for a workspace lives in .phrack/, including the
# local config.yaml. Ship config.example.yaml as the template instead.
.phrack/

# Legacy pre-.phrack locations (older setups): ignore if still present.
config.yaml
data/

# --- Scratch scan output ---
# Joern CPG binaries built when indexing a target; regenerated on demand.
workspace/
# SQLite file created at runtime by target/vuln_app.py.
target/*.db
# Runtime logs.
*.log

# --- Editor / OS cruft ---
.claude/settings.local.json
.idea/
.vscode/
*.swp
*~
.DS_Store
Thumbs.db
